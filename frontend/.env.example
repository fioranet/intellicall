# ── IntelliCall AI — frontend configuration ──────────────────────────────────
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# Both variables are NEXT_PUBLIC_*, so they are inlined into the browser bundle
# at build time. Never put a secret in this file — anything here is public.
# After changing a value, rebuild the frontend (npm run build) for it to apply.

# Base URL of the IntelliCall backend API, including the /api suffix.
# Local development:  http://localhost:5001/api
# Production:         https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Public URL of this dashboard itself. Used for SEO metadata, sitemap.xml and
# robots.txt. Defaults to http://localhost:3000 when unset.
# Production: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
