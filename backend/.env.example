# ── Core ─────────────────────────────────────────────────────────────────────
PORT=5001
MONGODB_URI=mongodb://localhost:27017/intellicall-ai
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_change_this
# Public URL of this backend (used for OAuth callbacks and Twilio webhooks)
BASE_URL=https://your-backend-domain.com
# Public URL of the frontend
CLIENT_URL=http://localhost:3000

# ── Google OAuth (login, Sheets, Calendar) ───────────────────────────────────
# Sheets and Calendar can also be configured from Admin → Integrations → Google,
# which takes priority over these and needs no restart. This block still drives
# "Sign in with Google" on the login page.
# The client ID always ends in .apps.googleusercontent.com — pasting a project
# number or the client secret here is what produces Google's "Error 401:
# invalid_client / The OAuth client was not found" page.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Optional explicit callback overrides (defaults derive from BASE_URL)
# GOOGLE_SHEETS_CALLBACK_URL=
# GOOGLE_CALENDAR_CALLBACK_URL=

# ── HubSpot integration ──────────────────────────────────────────────────────
# Nothing to configure here. Each user connects HubSpot by pasting a service
# key from their own account under Settings → Integrations.
#
# The variables below drive the LEGACY OAuth app flow and are only useful if
# you registered a HubSpot public app before 23 June 2026, when HubSpot closed
# new public app creation. They can also be set in Admin → Integrations.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_CALLBACK_URL=

# ── Slack integration (optional — can also be set in Admin → Integrations) ───
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_CALLBACK_URL=

# NOTE: The WhatsApp integration needs NO server-side keys here.
# Each user connects their own Meta WhatsApp Cloud API credentials
# from Settings → Integrations → WhatsApp.

# ── Asterisk / SIP (only needed when using SIP trunks) ───────────────────────
# ASTERISK_ARI_URL=http://127.0.0.1:8088
# ASTERISK_ARI_USER=intellicall
# ASTERISK_ARI_PASSWORD=change_me
# ASTERISK_CONFIG_DIR=/etc/asterisk
# EXTERNAL_IP=
# IC_SIP_PORT=5090
# SIP_RTP_PORT_START=
# SIP_RTP_PORT_END=
# SIP_MAX_CONCURRENT_CALLS=
# Max entries kept in the in-memory SIP debug log (SIP Trunks → Debug)
# SIP_LOG_MAX_ENTRIES=500
# Inbound SIP scanner guard: ban a source IP after N calls to unknown numbers
# within the window; banned calls are dropped silently for the ban duration
# SIP_SCAN_BAN_THRESHOLD=5
# SIP_SCAN_WINDOW_MINUTES=10
# SIP_SCAN_BAN_MINUTES=60
# SIP_RECORDING_PATH=/var/spool/asterisk/recording/intellicall
# SIP_TLS_CERT=
# SIP_TLS_KEY=
# SIP_TLS_CA=

# ── Misc (optional) ──────────────────────────────────────────────────────────
# OPENROUTER_KB_MODEL=
# TEST_CALL_TIMEOUT_MS=

# ── Voice call tuning (optional) ─────────────────────────────────────────────
# Hang up a connected-but-silent call after this long with no activity (default 5 min)
# CALL_IDLE_TIMEOUT_MS=300000
# Treat a SIP call as gone after this long with no inbound RTP (default 15s)
# SIP_RTP_SILENCE_TIMEOUT_MS=15000
# Outbound agent-audio playout buffer bound, in 20ms packets (default 3000 = 60s)
# SIP_RTP_MAX_QUEUE=3000

# Sarvam server-side VAD. This is where caller-side noise is rejected — raise the
# threshold against TV/crosstalk/ambient speech, and min-speech against clicks,
# coughs and DTMF. Defaults below are Sarvam's telephony preset.
# SARVAM_VAD_THRESHOLD=0.7          # speech-onset probability, 0.0-1.0
# SARVAM_VAD_MIN_SPEECH_MS=200      # main dial against false barge-in
# SARVAM_VAD_SILENCE_MS=500         # silence that ends a caller's turn
# Words needed to cut the agent off mid-sentence. 1 lets a single "hello" interrupt;
# raise to 2 if line echo is observed interrupting the agent. Shorter utterances are
# still queued and answered once it finishes — never dropped.
# SARVAM_BARGE_IN_MIN_WORDS=1

# Gemini Live engine (SIP numbers only). The API key itself is stored per-user in
# Settings, not here. The model can be swapped without a code change; VAD knobs map
# to Gemini's automaticActivityDetection settings.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_VAD_START_SENSITIVITY=START_SENSITIVITY_LOW
# GEMINI_VAD_END_SENSITIVITY=END_SENSITIVITY_HIGH
# GEMINI_VAD_PREFIX_PADDING_MS=120
# GEMINI_VAD_SILENCE_MS=700

# Only read by scripts/sarvam-preflight.js, never by the app itself — the Sarvam
# key the agents use is stored per-user in Settings, not here.
# SARVAM_API_KEY=
